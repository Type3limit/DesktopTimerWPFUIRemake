<UserControl
    x:Class="DesktopTimer.Views.Window.Conversation.MarkDownViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DesktopTimer.Views.Window.Conversation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://github.com/whistyun/MdXaml"
    x:Name="root"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <md:MarkdownScrollViewer x:Name="Markdownview" Markdown="{Binding ElementName=root, Path=MarkdownDocment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
</UserControl>
